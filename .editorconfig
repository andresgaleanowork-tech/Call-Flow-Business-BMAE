# D4 — Configuración compartida de editor (§14.6 maestro: LF, 2 espacios, sin
# líneas en blanco consecutivas >2). EditorConfig la aplican IDEs sin tooling.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
max_line_length = 110

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
